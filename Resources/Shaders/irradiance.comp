#version 450
#extension GL_GOOGLE_include_directive : require

// Diffuse irradiance convolution: cosine-weighted integral of the environment over the hemisphere around each direction.

#include "Ibl.glsl"

layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

layout(set = 0, binding = 0) uniform textureCube uEnvironment;
layout(set = 0, binding = 1) uniform sampler uSampler;
layout(set = 0, binding = 2, rgba16f) uniform writeonly image2DArray uDest;

layout(push_constant) uniform PushBlock
{
	vec4 Params; // x destination size, y source lod used for sampling
} Push;

void main()
{
	uvec3 id = gl_GlobalInvocationID;
	uint size = uint(Push.Params.x);
	if(id.x >= size || id.y >= size)
		return;

	vec2 uv = (vec2(id.xy) + 0.5) / float(size);
	vec3 N = CubeDirection(id.z, uv);
	vec3 up = abs(N.y) < 0.999 ? vec3(0.0, 1.0, 0.0) : vec3(1.0, 0.0, 0.0);
	vec3 right = normalize(cross(up, N));
	up = cross(N, right);

	const int phiSteps = 96;
	const int thetaSteps = 32;
	vec3 sum = vec3(0.0);
	for(int i = 0; i < phiSteps; i++)
	{
		float phi = (float(i) + 0.5) / float(phiSteps) * 2.0 * PI;
		for(int j = 0; j < thetaSteps; j++)
		{
			float theta = (float(j) + 0.5) / float(thetaSteps) * 0.5 * PI;
			vec3 tangentSample = vec3(sin(theta) * cos(phi), sin(theta) * sin(phi), cos(theta));
			vec3 dir = tangentSample.x * right + tangentSample.y * up + tangentSample.z * N;
			sum += textureLod(samplerCube(uEnvironment, uSampler), dir, Push.Params.y).rgb * cos(theta) * sin(theta);
		}
	}
	// integral = PI * average of (L * cos * sin) normalised by the sample density
	vec3 irradiance = sum * (PI * 0.5 * 2.0 * PI) / float(phiSteps * thetaSteps) / PI;
	imageStore(uDest, ivec3(id), vec4(irradiance, 1.0));
}
